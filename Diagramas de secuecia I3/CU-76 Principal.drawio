" /></mxGeometry></mxCell><mxCell id="m4" value="4. Selecciona su preferencia" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="170" y="351" as="sourcePoint" /><mxPoint x="660" y="351" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m5" value="5. Solicita registrar la decisión" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="660" y="413" as="sourcePoint" /><mxPoint x="905" y="413" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m6" value="6. Cifra y guarda la preferencia" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="905" y="475" as="sourcePoint" /><mxPoint x="1640" y="475" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" value="7. Confirma la cookie persistida" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1640" y="537" as="sourcePoint" /><mxPoint x="905" y="537" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" value="8. Envía decisión, versión e IP anonimizada" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="905" y="599" as="sourcePoint" /><mxPoint x="1150" y="599" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" value="9. Solicita registrar el consentimiento" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1150" y="661" as="sourcePoint" /><mxPoint x="1395" y="661" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m10" value="10. Guarda la decisión con marca de tiempo" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1395" y="723" as="sourcePoint" /><mxPoint x="1885" y="723" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m11" value="11. Confirma el consentimiento almacenado" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1885" y="785" as="sourcePoint" /><mxPoint x="1395" y="785" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" value="12. Devuelve el registro confirmado" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1395" y="847" as="sourcePoint" /><mxPoint x="1150" y="847" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m13" value="13. Confirma la persistencia" style="edgeStyle=none;orthogonalLoop=1;je