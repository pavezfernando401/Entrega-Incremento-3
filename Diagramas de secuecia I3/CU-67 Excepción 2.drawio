dth="10" height="228" /></mxCell><mxCell id="act5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1390" y="275" width="10" height="104" /></mxCell><mxCell id="act6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1635" y="461" width="10" height="104" /></mxCell><mxCell id="act7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1880" y="585" width="10" height="724" /></mxCell><mxCell id="m1" value="1. Activa la tarea diaria de recordatorios" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="170" y="165" as="sourcePoint" /><mxPoint x="660" y="165" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m2" value="2. Consulta facturas impagas que vencen en tres días" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="660" y="227" as="sourcePoint" /><mxPoint x="1150" y="227" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m3" value="3. Solicita cliente y canal de contacto" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1150" y="289" as="sourcePoint" /><mxPoint x="1395" y="289" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m4" value="4. Devuelve nombre y correo registrado" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1395" y="351" as="sourcePoint" /><mxPoint x="1150" y="351" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m5" value="5. Retorna la factura por vencer" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1150" y="413" as="sourcePoint" /><mxPoint x="660" y="413" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m6" value="6. Obtiene la plantilla de recordatorio" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="660" y="475" as="sourcePoint" /><mxPoint x="1640" y="475" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" value="7. Devuelve la plantilla activa" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1640" y="537" as="sourcePoint" /><mxPoint x="660" y="537" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" value="8. Registra el envío en curso" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="660" y="599" as="sourcePoint" /><mxPoint x="1885" y="599" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" value="9. Devuelve el identificador del registro" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1885" y="661" as="sourcePoint" /><mxPoint x="660" y="661" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m10" value="10. Solicita el primer despacho" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="660" y="723" as="sourcePoint" /><mxPoint x="905" y="723" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m11" value="11. Intenta entregar el recordatorio" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="905" y="785" as="sourcePoint" /><mxPoint x="415" y="785" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" value="12. Informa que la entrega falló" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="415" y="847" as="sourcePoint" /><mxPoint x="905" y="847" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m13" value="13. Devuelve el error del primer intento" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="905" y="909" as="sourcePoint" /><mxPoint x="660" y="909" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m14" value="14. Solicita reintentar el despacho" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="660" y="971" as="sourcePoint" /><mxPoint x="905" y="971" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m15" value="15. Reintenta entregar el recordatorio" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="905" y="1033" as="sourcePoint" /><mxPoint x="415" y="1033" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m16" value="16. Informa un segundo fallo de entrega" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="415" y="1095" as="sourcePoint" /><mxPoint x="905" y="1095" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m17" value="17. Confirma que el reintento falló" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="905" y="1157" as="sourcePoint" /><mxPoint x="660" y="1157" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m18" value="18. Marca el evento como fallido" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="660" y="1219" as="sourcePoint" /><mxPoint x="1885" y="1219" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m19" value="19. Confirma el registro para revisión" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="1885" y="1281" as="sourcePoint" /><mxPoint x="660" y="1281" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m20" value="20. Devuelve el estado no notificado" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="660" y="1343" as="sourcePoint" /><mxPoint x="415" y="1343" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m21" value="21. Finaliza con el aviso pendiente de revisión" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="415" y="1405" as="sourcePoint" /><mxPoint x="170" y="1405" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>