Width=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="660" y="785" as="sourcePoint" /><mxPoint x="415" y="785" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=12;fontFamily=Arial;labelBackgroundColor=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint x="415" y="847" as="sourcePoint" /><mxPoint x="170" y="847" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label_m1" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;1. Presiona Descargar en el pago&lt;br&gt;seleccionado&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m1"><mxGeometry x="0" y="0" width="230.33333333333334" height="25.333333333333332" relative="1" as="geometry"><mxPoint x="-115.16666666666667" y="-30.333333333333332" as="offset" /></mxGeometry></mxCell><mxCell id="label_m2" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;2. Solicita descargar la boleta del pago&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m2"><mxGeometry x="0" y="0" width="230.33333333333334" height="12.666666666666666" relative="1" as="geometry"><mxPoint x="-115.16666666666667" y="-17.666666666666664" as="offset" /></mxGeometry></mxCell><mxCell id="label_m3" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;3. GET /portal/pagos/{id}/comprobante&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m3"><mxGeometry x="0" y="0" width="230.33333333333334" height="12.666666666666666" relative="1" as="geometry"><mxPoint x="-115.16666666666667" y="-17.666666666666664" as="offset" /></mxGeometry></mxCell><mxCell id="label_m4" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;4. Solicita la boleta para el cliente&lt;br&gt;autenticado&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m4"><mxGeometry x="0" y="0" width="230.33333333333334" height="25.333333333333332" relative="1" as="geometry"><mxPoint x="-115.16666666666667" y="-30.333333333333332" as="offset" /></mxGeometry></mxCell><mxCell id="label_m5" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;5. Consulta el pago asociado al cliente&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m5"><mxGeometry x="0" y="0" width="475.3333333333333" height="12.666666666666666" relative="1" as="geometry"><mxPoint x="-237.66666666666666" y="-17.666666666666664" as="offset" /></mxGeometry></mxCell><mxCell id="label_m6" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;6. Devuelve el pago y confirma su pertenencia&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m6"><mxGeometry x="0" y="0" width="475.3333333333333" height="12.666666666666666" relative="1" as="geometry"><mxPoint x="-237.66666666666666" y="-17.666666666666664" as="offset" /></mxGeometry></mxCell><mxCell id="label_m7" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;7. Solicita la boleta electrónica del pago&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m7"><mxGeometry x="0" y="0" width="230.33333333333334" height="12.666666666666666" relative="1" as="geometry"><mxPoint x="-115.16666666666667" y="-17.666666666666664" as="offset" /></mxGeometry></mxCell><mxCell id="label_m8" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;8. Sin PDF por datos incompletos.&lt;br&gt;Incidencia registrada&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m8"><mxGeometry x="0" y="0" width="230.33333333333334" height="25.333333333333332" relative="1" as="geometry"><mxPoint x="-115.16666666666667" y="-30.333333333333332" as="offset" /></mxGeometry></mxCell><mxCell id="label_m9" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;9. Informa que faltan datos para emitir la&lt;br&gt;boleta&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m9"><mxGeometry x="0" y="0" width="230.33333333333334" height="25.333333333333332" relative="1" as="geometry"><mxPoint x="-115.16666666666667" y="-30.333333333333332" as="offset" /></mxGeometry></mxCell><mxCell id="label_m10" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;10. Devuelve el aviso sin archivo PDF&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m10"><mxGeometry x="0" y="0" width="230.33333333333334" height="12.666666666666666" relative="1" as="geometry"><mxPoint x="-115.16666666666667" y="-17.666666666666664" as="offset" /></mxGeometry></mxCell><mxCell id="label_m11" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;11. Solicita mostrar el motivo de la&lt;br&gt;indisponibilidad&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;strokeColor=none;labelBackgroundColor=none;labelBorderColor=none;" vertex="1" connectable="0" parent="m11"><mxGeometry x="0" y="0" width="230.33333333333334" height="25.333333333333332" relative="1" as="geometry"><mxPoint x="-115.16666666666667" y="-30.333333333333332" as="offset" /></mxGeometry></mxCell><mxCell id="label_m12" value="&lt;div style=&quot;line-height:12.666667px&quot;&gt;12. Informa que faltan datos y no descarga&lt;br&gt;la boleta&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=fill;rounded=0;spacing=0;fontFamily=Arial;fontSize=11.333333;fontStyle=1;fontColor=#000000;fillColor=none;s